{
  "name": "shop-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant fake e-commerce API for the observability learning docs. Fake data only, never point at real customer data.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
    "dev:plain": "tsx watch src/server.ts",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "payment:dev": "tsx watch src/payment-service.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@sentry/node": "11.10.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
